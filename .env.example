# Konfigurasi Video Clipping Engine.
# Lebih mudah diisi lewat halaman Setting di browser daripada menyunting di sini.
# File ini TIDAK ikut commit.

# =====================================================================
# 1. TRANSKRIP  (Stage 2)
# =====================================================================
# groq       : gratis untuk pemakaian wajar, sangat cepat. Meleset di campuran
#              Indonesia-Inggris, dan menolak IP datacenter/VPN dengan 403.
#              Key: https://console.groq.com/keys
# elevenlabs : jauh lebih akurat untuk Bahasa Indonesia, berbayar per pemakaian.
#              Key: https://elevenlabs.io/app/settings/api-keys
ASR_PROVIDER=groq
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2

# =====================================================================
# 2. SELEKSI MOMEN & METADATA  (Stage 3 & 8)
# =====================================================================
# gemini     : ada free tier. Boleh diisi beberapa key dipisah koma — dipakai
#              bergiliran karena kuota gratisnya dibatasi PER KEY.
#              Key: https://aistudio.google.com/apikey
# openrouter : satu key untuk banyak model. https://openrouter.ai/keys
LLM_PROVIDER=gemini
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# =====================================================================
# 3. INFRA
# =====================================================================
# Diisi otomatis oleh docker compose. Ubah hanya kalau menjalankan tanpa Docker.
DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper
REDIS_URL=redis://localhost:6379/0
API_PORT=8000

# =====================================================================
# 4. KEAMANAN
# =====================================================================
# Kosong = tanpa autentikasi. Aman SELAMA server hanya mendengar di localhost.
# WAJIB diisi kalau dibuka ke jaringan atau di-tunnel keluar — halaman Setting
# bisa dipakai melihat status kredensial dan menimpanya.
AUTH_TOKEN=

# =====================================================================
# 5. OPSIONAL — semua punya default di config/settings.py
# =====================================================================
# CLIPS_DIR=clips           folder tempat klip jadi disimpan
# TARGET_CLIPS_DEFAULT=8
# MIN_CLIP_SEC=30
# MAX_CLIP_SEC=90
# JOB_TIMEOUT_SEC=1800
# SILENCE_NOISE_DB=-30      turunkan ke -35 kalau source ada musik latar
# SILENCE_MIN_DUR=0.25
# SNAP_MAX_DRIFT=1.2

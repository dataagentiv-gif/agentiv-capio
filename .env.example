# Salin ke .env di folder yang sama, lalu isi. .env tidak ikut commit.

# --- Transkrip (Stage 2) --- https://console.groq.com/keys
GROQ_API_KEY=

# --- LLM (Stage 3 & 8) ---
# openrouter | gemini
LLM_PROVIDER=openrouter

# Gemini dipanggil langsung lewat endpoint OpenAI-compatible milik Google.
# Boleh lebih dari satu key dipisah koma; key dirotasi bergiliran tiap panggilan
# karena free tier Gemini dibatasi PER KEY.
#   GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- Infra lokal (lihat docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper
REDIS_URL=redis://localhost:6379/0

# Ganti kalau 8000 bentrok dengan proses lain.
# API_PORT=8000

# --- Penyimpanan klip ---
# local = klip jadi file mp4 biasa di folder clips/. Tidak butuh akun apa pun.
# r2    = diunggah ke Cloudflare R2.
STORAGE_PROVIDER=local
# CLIPS_DIR=clips

# --- Cloudflare R2 (hanya kalau STORAGE_PROVIDER=r2) ---
# R2_ACCOUNT_ID ada di URL dashboard Cloudflare.
# Access key dibuat di R2 > Manage API Tokens.
# R2_PUBLIC_BASE_URL = custom domain atau r2.dev bucket, TANPA slash di akhir.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-clipper
R2_PUBLIC_BASE_URL=

# --- Guardrail (opsional, ada default di config/settings.py) ---
# JOB_TIMEOUT_SEC=1800
# MIN_CLIP_SEC=30
# MAX_CLIP_SEC=90
# TARGET_CLIPS_DEFAULT=8

# --- Kalibrasi (opsional) ---
# SILENCE_NOISE_DB=-30      # -35 kalau source ada musik latar
# SILENCE_MIN_DUR=0.25
# SNAP_MAX_DRIFT=1.2
# WORK_DIR=C:/work

# --- Keamanan ---
# Kosong = tanpa autentikasi. Itu aman SELAMA API_HOST tetap 127.0.0.1.
# WAJIB diisi kalau server dibuka ke jaringan atau di-tunnel keluar: halaman
# /settings bisa dipakai melihat status kredensial dan menimpanya.
# Isi dengan string acak panjang, lalu login lewat prompt browser
# (username diabaikan, password = nilai ini).
AUTH_TOKEN=

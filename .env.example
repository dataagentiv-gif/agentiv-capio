# Konfigurasi Video Clipping Engine.
# Lebih mudah diisi lewat halaman Setting di browser daripada menyunting di sini.
# File ini TIDAK ikut commit.

# =====================================================================
# 1. TRANSKRIP (Stage 2) & SELEKSI MOMEN/METADATA (Stage 3 & 8)
# =====================================================================
# Satu key Gemini buat dua tugas. Ada free tier, dibatasi PER PROJECT Google
# Cloud, bukan per key — key tambahan cuma menaikkan jatah kalau dibuat di
# project lain. Boleh diisi beberapa dipisah koma, dipakai bergiliran.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Pakai alias "-latest", jangan nomor versi. Google menutup model lama untuk
# pengguna BARU sambil membiarkan project lama tetap memakainya, jadi nomor
# versi yang ditulis di sini akan menghasilkan HTTP 404 "no longer available
# to new users" — yang gejalanya mirip key salah, padahal bukan.
GEMINI_MODEL=gemini-flash-lite-latest

# =====================================================================
# 2. LISENSI
# =====================================================================
# Lebih mudah diisi lewat halaman Setting — key ditulis balik ke file ini
# begitu terverifikasi. Kosong = aplikasi tetap jalan normal, cuma submit
# job BARU yang diblokir; klip yang sudah ada tetap bisa dibuka dan diunduh.
LICENSE_KEY=
# Kosong = pakai server lisensi produksi. Diisi hanya untuk staging atau
# pengujian dari mesin sendiri.
LICENSE_SERVER=

# =====================================================================
# 3. TAMPILAN KLIP  (Stage 5 & 7)
# =====================================================================
# Ini cuma nilai AWAL di halaman Submit — layout dan gaya caption sebenarnya
# dipilih PER VIDEO saat submit, bukan sekali untuk semua video di sini.
# Layout: penuh | kotak | samping | ori — lihat pipeline/layout.py untuk
# bedanya masing-masing.
CLIP_LAYOUT=penuh
CAPTION_FONT=Poppins
CAPTION_SIZE=0      # 0 = ikut bawaan layout
CAPTION_COLOR=FFE500
CAPTION_WORDS=0     # 0 = ikut bawaan layout
CAPTION_UPPER=false
# Gaya kata aktif: text_color | background | background_scale
# Angka blok dalam piksel kanvas 1080x1920, dipakai dua gaya blok saja.
ACTIVE_WORD_STYLE=text_color
ACTIVE_WORD_BACKGROUND_COLOR=FFE500
ACTIVE_WORD_TEXT_COLOR=000000
ACTIVE_WORD_BORDER_RADIUS=18
ACTIVE_WORD_PADDING_X=18
ACTIVE_WORD_PADDING_Y=8

# =====================================================================
# 4. KINERJA
# =====================================================================
# single (bawaan): satu job diproses sekaligus — aman untuk laptop/PC kecil.
# multi: beberapa job diproses BERSAMAAN, lebih cepat kalau CPU-nya cukup —
# tapi tiap job menjalankan ffmpeg yang memakai SEMUA core yang ada tanpa
# batas. Di mesin kecil, job paralel bisa membuat KEDUANYA lebih lambat,
# bukan lebih cepat. Butuh restart worker (docker compose up -d) supaya
# perubahannya berlaku.
WORKER_MODE=single
WORKER_COUNT=2

# =====================================================================
# 5. INFRA
# =====================================================================
# Diisi otomatis oleh docker compose. Ubah hanya kalau menjalankan tanpa Docker.
DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper
REDIS_URL=redis://localhost:6379/0
# Port yang dipakai di browser.
#   HOST_PORT : saat jalan dengan Docker (docker compose)
#   API_PORT  : saat jalan tanpa Docker (python main.py api)
# Diisi sama supaya tidak membingungkan.
HOST_PORT=8000
API_PORT=8000

# =====================================================================
# 6. KEAMANAN
# =====================================================================
# Kosong = tanpa autentikasi. Aman SELAMA server hanya mendengar di localhost.
# WAJIB diisi kalau dibuka ke jaringan atau di-tunnel keluar — halaman Setting
# bisa dipakai melihat status kredensial dan menimpanya.
AUTH_TOKEN=

# =====================================================================
# 7. OPSIONAL — semua punya default di config/settings.py
# =====================================================================
# CLIPS_DIR=clips           folder tempat klip jadi disimpan
# TARGET_CLIPS_DEFAULT=8
# MIN_CLIP_SEC=30
# MAX_CLIP_SEC=90
# JOB_TIMEOUT_SEC=1800
# SILENCE_NOISE_DB=-30      turunkan ke -35 kalau source ada musik latar
# SILENCE_MIN_DUR=0.25
# SNAP_MAX_DRIFT=1.2

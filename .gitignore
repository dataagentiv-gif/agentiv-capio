.env
# Backup .env tetap berisi kredensial, jadi jangan sampai lolos ke commit.
.env.*
!.env.example

venv/
__pycache__/
*.pyc
.pytest_cache/

# Working directory per job. Isinya source.mp4 mentah (bisa ratusan MB) plus
# artefak antar-stage; semuanya sekali pakai dan dihapus setelah upload ke R2.
work/
*.mp4
*.ogg
*.ass

*.log
.DS_Store

# Fixture test di-generate, bukan di-commit (tests/fixtures/make_fixture.py).
tests/fixtures/sample.mp4

# Cache lokal wrangler (login state), bukan bagian dari project.
.wrangler/

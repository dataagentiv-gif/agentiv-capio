.env
# Backup .env tetap berisi kredensial, jadi jangan sampai lolos ke commit.
.env.*
!.env.example

venv/
__pycache__/
*.pyc
.pytest_cache/

# Working directory per job. Isinya source.mp4 mentah (bisa ratusan MB) plus
# artefak antar-stage; semuanya sekali pakai dan dihapus setelah job sukses.
work/
*.mp4
*.ogg
*.ass

# Kecuali contoh hasil per layout di halaman Submit. Ini ASET PRODUK, bukan
# artefak job: tanpa berkasnya, pemilih tampilan cuma menampilkan kotak hitam.
# Kalau tidak ikut di-commit, ia cuma ada di mesin yang membuatnya — clone baru
# menghasilkan image yang diam-diam lebih buruk, tanpa satu pun tanda bahwa ada
# yang hilang.
!web/static/contoh/*.mp4

*.log
.DS_Store

# Fixture test di-generate, bukan di-commit (tests/fixtures/make_fixture.py).
tests/fixtures/sample.mp4

# Cache lokal wrangler (login state), bukan bagian dari project.
.wrangler/

# Klip hasil render saat STORAGE_PROVIDER=local.
clips/

# install_id dan license.json lokal (DATA_DIR) — data perangkat, bukan kode.
# Named volume di Docker, bind mount kalau dijalankan langsung tanpa compose.
data/

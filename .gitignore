.env
# Backup .env tetap berisi kredensial, jadi jangan sampai lolos ke commit.
.env.*
!.env.example

venv/
__pycache__/
*.pyc
.pytest_cache/

# Working directory per job. Isinya source.mp4 mentah (bisa ratusan MB) plus
# artefak antar-stage; semuanya sekali pakai dan dihapus setelah job sukses.
work/
*.mp4
*.ogg
*.ass

# Kecuali satu: video contoh untuk pratinjau tampilan. Ini ASET PRODUK, bukan
# artefak job — tanpa dia, pratinjau di halaman Submit jatuh ke potongan klip
# terakhir pengguna yang caption-nya sudah terbakar. Kalau tidak ikut di-commit,
# ia cuma ada di mesin yang membuatnya: clone baru menghasilkan image yang
# pratinjaunya diam-diam lebih buruk, tanpa satu pun tanda bahwa ada yang hilang.
!assets/preview.mp4

*.log
.DS_Store

# Fixture test di-generate, bukan di-commit (tests/fixtures/make_fixture.py).
tests/fixtures/sample.mp4

# Cache lokal wrangler (login state), bukan bagian dari project.
.wrangler/

# Klip hasil render saat STORAGE_PROVIDER=local.
clips/
